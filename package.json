{
  "name": "@constellation-network/metagraph-monitoring-service",
  "version": "1.0.0",
  "description": "Constellation metagraph monitoring service",
  "private": true,
  "scripts": {
    "start:server": "ts-node -r tsconfig-paths/register src/server/main.ts",
    "start:server:dev": "ts-node -r tsconfig-paths/register --watch src/server/main.ts",
    "start:ui": "next dev --port 3000 src/ui",
    "start:gateway": "ts-node src/gateway/index.ts",
    "build:ui": "next build src/ui",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up -d",
    "setup": "./scripts/setup.sh",
    "migrate": "./scripts/migrate.sh",
    "deploy": "./scripts/deploy.sh",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix"
  },
  "author": "Marcus Girolneto <marcus.girolneto@gmail.com>",
  "homepage": "https://github.com/Constellation-Labs/metagraph-monitoring-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constellation-Labs/metagraph-monitoring-service.git"
  },
  "bugs": {
    "url": "https://github.com/Constellation-Labs/metagraph-monitoring-service/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.855.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.6.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.19",
    "helmet": "^8.1.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "^1.15.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
