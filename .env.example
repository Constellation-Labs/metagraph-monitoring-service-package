# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Opsgenie (optional)
OPSGENIE_API_KEY=

# AWS (optional - for instance reboot)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1
AWS_SESSION_TOKEN=

# Discord (optional - for notifications)
DISCORD_WEBHOOK_URL=

# SSH Key path (for Docker volume mount)
SSH_KEY_PATH=~/.ssh/id_rsa
